---
layout: none
permalink: /feed.xml
---

<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ "/feed.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self" type="application/rss+xml"/>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {%- for post in site.posts %}
      <item>
        <title>{{post.categories | first | capitalize }} - {{ post.title | xml_escape }}</title>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <description><![CDATA[
  {%- if post.category != "animation"%}
    <img src="/assets/images/portfolio/{{post.category}}/{{post.number}}/thumb.webp"/>
  {%- else %}
    <video loop autoplay muted playsinline>
      <source src="/assets/images/portfolio/{{post.category}}/{{post.number}}/thumb.webm" type="video/webm">
    </video>
  {%- endif %}

  {{ post.content }}

  <a href="{{ site.url }}{{ post.url }}">See more images and related artwork ↗</a>
        ]]></description>
        <link>{{ post.url | prepend: site.baseurl | prepend: site.url | xml_escape }}</link>
      </item>
    {%- endfor %}
  </channel>
</rss>
